# Adaptador de Nebius (ver flowguard-docs/security.md § 1.5 y § 1.8)
# Mientras la checklist de compatibilidad no esté confirmada, AGENT_PROVIDER=mock
# usa la respuesta simulada en src/server/agent/mockProvider.ts.
AGENT_PROVIDER=mock

NEBIUS_API_KEY=replace_with_secret
NEBIUS_BASE_URL=replace_with_verified_endpoint
NEBIUS_MODEL=replace_with_supported_model_id

AGENT_MAX_TOOL_CALLS=5
AGENT_TIMEOUT_MS=15000
AGENT_WORKER_CONCURRENCY=2
AGENT_WORKER_POLL_INTERVAL_MS=2000

# Persistencia (flowguard-docs/security.md § 2.0). Solo en el servidor, nunca en el navegador.
# Pendiente de definir por Dev 1: el nombre de la variable con la URL del proyecto Supabase.
SUPABASE_SERVICE_ROLE_KEY=replace_with_secret

# Rate limiting (flowguard-docs/security.md § 2.4). En local se desactiva.
RATE_LIMIT_ENABLED=false
# TRUSTED_PROXY_HEADER=   # Depende de la plataforma de hosting; decisión de Dev 1 (día 3)

# Basic Auth de la demo pública (flowguard-docs/security.md § 2.0). Solo si la demo se expone en una URL pública.
# Las credenciales reales NUNCA se guardan en Git.
# DEMO_BASIC_AUTH_USER=
# DEMO_BASIC_AUTH_PASSWORD=
