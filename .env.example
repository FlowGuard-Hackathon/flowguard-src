# Adaptador de Nebius (ver flowguard-docs/security.md § 1.5 y § 1.8)
# Mientras la checklist de compatibilidad no esté confirmada, AGENT_PROVIDER=mock
# usa la respuesta simulada en src/server/agent/mockProvider.ts.
AGENT_PROVIDER=mock

NEBIUS_API_KEY=replace_with_secret
NEBIUS_BASE_URL=replace_with_verified_endpoint
NEBIUS_MODEL=replace_with_supported_model_id

AGENT_MAX_TOOL_CALLS=5
AGENT_TIMEOUT_MS=15000
AGENT_WORKER_CONCURRENCY=2
AGENT_WORKER_POLL_INTERVAL_MS=2000
