# Agente (flowguard-docs/seguridad.md § 1.5 y § 1.8).
# simulado = informe de prueba sin credenciales; nebius = proveedor real (aún no implementado).
AGENTE_PROVEEDOR=simulado

NEBIUS_CLAVE_API=replace_with_secret
NEBIUS_URL_BASE=replace_with_verified_endpoint
NEBIUS_MODELO=replace_with_supported_model_id

AGENTE_MAX_LLAMADAS_HERRAMIENTAS=5
AGENTE_TIEMPO_LIMITE_MS=15000
AGENTE_CONCURRENCIA_PROCESOS=2
AGENTE_INTERVALO_SONDEO_MS=2000

# Persistencia (seguridad.md § 2.0). Solo en el servidor, nunca en el navegador.
# Pendiente de definir por Dev 1: el nombre de la variable con la URL del proyecto Supabase.
SUPABASE_CLAVE_ROL_SERVICIO=replace_with_secret

# Límite de solicitudes (seguridad.md § 2.4). En local se desactiva.
LIMITE_SOLICITUDES_ACTIVO=false
# ENCABEZADO_PROXY_CONFIABLE=   # Depende de la plataforma de hosting; decisión de Dev 1 (día 3)

# Basic Auth de la demo pública (seguridad.md § 2.0). Solo si la demo se expone en una URL pública.
# Las credenciales reales NUNCA se guardan en Git.
# DEMO_AUTH_BASICA_USUARIO=
# DEMO_AUTH_BASICA_CONTRASENA=
